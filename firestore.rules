rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — users can read their own profile, admins can read/write all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'admin');
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Tenant-scoped data — admins can access all tenants, clients only their own
    match /tenants/{tenantId}/{document=**} {
      allow read: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.tenantId == tenantId
      );
      allow write: if request.auth != null && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.tenantId == tenantId && request.auth.token.role == 'client')
      );
    }
  }
}
